## ==========================================
## Microsoft .NET & Visual Studio GitIgnore
## ==========================================

# Build Results & Binaries
[Bb]in/
[Oo]bj/
[Oo]ut/
*.dll
*.exe
*.pdb
*.cache
*.editorconfig.g.cs
*.AssemblyInfo.cs
*.AssemblyInfoInputs.cache

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.dtbcache*
ProjectEvaluation/
FileContentIndex/
*.vsidx
.futdcache*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# User Uploaded Storage (Do not commit uploaded candidate CVs)
**/Storage/Uploads/*
!**/Storage/Uploads/.gitkeep
**/Storage/Temp/*

# Temporary files and logs
*.tmp
*.log
*.bkp
.$*
.~*
.system_generated/
.user_uploaded/
scratch/

# OS specific
.DS_Store
Thumbs.db
desktop.ini
