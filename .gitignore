## ==========================================
## Microsoft .NET & Visual Studio GitIgnore
## ==========================================

# Build Results & Binaries
[Bb]in/
[Oo]bj/
[Oo]ut/
*.dll
*.exe
*.pdb
*.cache
*.editorconfig.g.cs
*.AssemblyInfo.cs
*.AssemblyInfoInputs.cache

# Visual Studio
.vs/
*.suo
*.user
*.csproj.user
*.userosscache
*.sln.docstates
*.dtbcache*
ProjectEvaluation/
FileContentIndex/
*.vsidx
.futdcache*
TestResults/
*.opencover.xml
coverage/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# User Uploaded Storage (Do not commit uploaded candidate CVs)
**/Storage/Uploads/*
!**/Storage/Uploads/.gitkeep
**/Storage/Temp/*

# Temporary files and logs
*.tmp
*.log
*.bkp
.$*
.~*
.system_generated/
.user_uploaded/
scratch/

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Project Documentation & Reports (Keep locally, do not push to repository)
reports/
*.pdf

# Python / AI Service
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.coverage
htmlcov/
ai-service/.env
*.env
!*.env.example


