{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TalentSyncAI.API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/TalentSyncAI.API/bin/Debug/net10.0/TalentSyncAI.API.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/TalentSyncAI.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openUrl",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}

