# ==============================================================================
# TalentSync-AI Environment Configuration
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# -------------------------------------------------------------
# 1. Database (SQL Server 2022)
# -------------------------------------------------------------
MSSQL_SA_PASSWORD=YourStrong@Passw0rd!

# -------------------------------------------------------------
# 2. JWT Authentication (Backend)
# Must be at least 32 characters long
# -------------------------------------------------------------
JWT_SECRET_KEY=SUPER_SECRET_KEY_FOR_LOCAL_DEV_TALENTSYNCAI_PLATFORM_2026_CHANGE_IN_PROD

# -------------------------------------------------------------
# 3. Internal Service-to-Service Security
# Used by Backend to authenticate calls to AI Service
# -------------------------------------------------------------
INTERNAL_API_KEY=dev-internal-api-key

# -------------------------------------------------------------
# 4. External AI Providers (Used by ai-service)
# -------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://backend.sovereigneg.com/v1
TAVILY_API_KEY=
LLAMA_CLOUD_API_KEY=
