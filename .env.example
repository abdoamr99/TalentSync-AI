# ============================================================
# TalentSyncAI - Environment Configuration Template
# ============================================================
# Copy this file to .env before running docker compose if you want to override defaults:
#   cp .env.example .env

# Shared Internal API Key for inter-service communication (.NET <-> FastAPI)
INTERNAL_API_KEY=dev-internal-api-key

# SQL Server Database Configuration
SQL_SA_PASSWORD=YourStrong@Passw0rd!

# External AI Provider Keys (Optional for live LLM workflows)
# If left blank, the platform automatically utilizes its built-in Mock Engine
OPENAI_API_KEY=
TAVILY_API_KEY=
LLAMA_CLOUD_API_KEY=
